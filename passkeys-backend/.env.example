# description: SID of your Twilio Account or Subaccount
# format: sid
# link: https://www.twilio.com/console
# required: true
ACCOUNT_SID=

# description: Auth Token of your Twilio Account or Subaccount
# format: text
# link: https://www.twilio.com/console
# required: true
AUTH_TOKEN=

# description: [Optional] SID of the Verify Service with Passkeys enabled. Leave empty and call /registration/service once to create one.
# format: sid
# required: false
VERIFY_SERVICE_SID=

# description: [Optional] Apple App ID (Team ID + bundle ID) allowed to use passkeys from this domain, e.g. ABCDE12345.com.example.passkeys
# format: text
# required: false
IOS_APP_ID=

# description: [Optional] Package name of the Android app allowed to use passkeys from this domain, e.g. com.example.passkeys
# format: text
# required: false
ANDROID_PACKAGE_NAME=

# description: [Optional] SHA-256 fingerprint of the Android app signing certificate, colon separated
# format: text
# required: false
ANDROID_SHA256_CERT_FINGERPRINT=
