# description: Your OpenAI API key, used to authenticate requests to the OpenAI Vector Stores API. Create one at https://platform.openai.com/api-keys
# format: secret
# required: true
# link: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# description: The id of the OpenAI vector store to search by default (e.g. "vs_abc123"), used when a request doesn't provide its own `vector_store_id`. Create one at https://platform.openai.com/storage/vector_stores
# format: text
# required: false
# link: https://platform.openai.com/storage/vector_stores
OPENAI_VECTOR_STORE_ID=
