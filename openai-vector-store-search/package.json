{
  "name": "openai-vector-store-search",
  "version": "1.0.0",
  "private": true,
  "description": "Query an OpenAI Vector Store for the documents most relevant to a search query",
  "scripts": {
    "test": "jest",
    "lint": "eslint --ext js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke-test": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-twilio": "^2.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest-cli": "^29.7.0",
    "nock": "^14.0.17",
    "prettier": "^3.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageThreshold": {
      "./functions/**/*.js": {
        "statements": 60,
        "branches": 60
      }
    }
  }
}
